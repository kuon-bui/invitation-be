# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invitation_db?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Authentication & JWT
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# S3 / Cloudflare R2 Storage (Media Uploads)
S3_REGION="auto"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# true for MinIO / self-hosted S3 (path-style URLs); leave false for Cloudflare R2 / AWS
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID="your-r2-or-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-or-s3-secret-access-key"
S3_BUCKET_NAME="invitation-assets"
S3_PUBLIC_DOMAIN="https://assets.invitation.com"

# VietQR / SePay Payment Gateway
SEPAY_ACC="0123456789"
SEPAY_BANK="MBBank"
SEPAY_WEBHOOK_API_KEY="your-sepay-secure-webhook-api-key"
# Lifetime package price in VND (server-side; client amounts are ignored)
PAYMENT_LIFETIME_PRICE=199000

# Telegram Notification Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
