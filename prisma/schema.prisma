datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum EventType {
  WEDDING
  CLASS_REUNION
  BIRTHDAY
  ANNIVERSARY
  GRAND_OPENING
  CUSTOM
}

enum InvitationStatus {
  DRAFT
  TRIAL
  ACTIVE
  EXPIRED
}

enum GuestSide {
  TRAI
  GAI
  CHUNG
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String?
  fullName     String
  phoneNumber  String?
  avatarUrl    String?
  role         Role          @default(USER)
  googleId     String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invitations  Invitation[]
  payments     Payment[]

  @@map("users")
}

model Template {
  id           String       @id // e.g.: "wedding-truyen-thong-01", "reunion-ky-niem-01"
  name         String
  eventType    EventType    @default(WEDDING)
  category     String       // e.g.: "hien-dai", "truyen-thong", "toi-gian", "hoa-co", "tap-chi"
  badge        String?      // e.g.: "Phổ biến", "Kinh điển", "Mới"
  styleDesc    String
  thumbnailUrl String?
  isActive     Boolean      @default(true)
  order        Int          @default(0)
  
  // JSON cấu hình màu sắc, font chữ, hoa văn, layout
  config       Json

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  invitations  Invitation[]

  @@map("templates")
}

model Invitation {
  id             String           @id @default(uuid())
  userId         String
  templateId     String
  eventType      EventType        @default(WEDDING)
  title          String           // "Đám cưới Văn Quân & Thùy Dung"
  slug           String           @unique // URL path: :slug
  status         InvitationStatus @default(TRIAL)
  eventDate      DateTime
  startTime      String?          // "11:30"
  venueName      String           // "Trung tâm Hội nghị Tiệc cưới Trống Đồng"
  venueAddress   String           // "Hà Nội"
  mapUrl         String?
  musicUrl       String?
  gallery        String[]         @default([])

  // Chứa dữ liệu riêng theo eventType
  details        Json             @default("{}")

  // Ghi đè cấu hình template (nếu cặp đôi muốn tùy biến màu sắc/font chữ riêng)
  customConfig   Json             @default("{}")

  trialEndsAt    DateTime?
  activatedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template       Template         @relation(fields: [templateId], references: [id])
  guests         Guest[]
  rsvps          Rsvp[]
  wishes         Wish[]
  payments       Payment[]
  notification   NotificationConfig?

  @@index([slug])
  @@index([userId])
  @@map("invitations")
}

model Guest {
  id           String       @id @default(uuid())
  weddingId    String       @map("invitation_id")
  name         String
  side         GuestSide    @default(CHUNG)
  phone        String?
  code         String       // Mã định danh ngắn ngẫu nhiên phục vụ link cá nhân
  hasViewed    Boolean      @default(false)
  viewedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  invitation   Invitation   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  rsvps        Rsvp[]

  @@unique([weddingId, code])
  @@index([weddingId])
  @@map("guests")
}

model Rsvp {
  id           String      @id @default(uuid())
  invitationId String
  guestId      String?
  guestName    String
  attending    Boolean     // true: tham dự, false: không tham dự
  guestCount   Int         @default(1)
  diet         String?     // "man", "chay"
  note         String?
  createdAt    DateTime    @default(now())

  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest        Guest?      @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@map("rsvps")
}

model Wish {
  id           String      @id @default(uuid())
  invitationId String
  senderName   String
  content      String
  isApproved   Boolean     @default(true)
  createdAt    DateTime    @default(now())

  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("wishes")
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  invitationId    String
  amount          Int           // Số tiền tính theo VNĐ
  transactionCode String        @unique // Mã tham chiếu khớp lệnh ngân hàng
  status          PaymentStatus @default(PENDING)
  rawWebhook      Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id])
  invitation      Invitation    @relation(fields: [invitationId], references: [id])

  @@index([transactionCode])
  @@map("payments")
}

model NotificationConfig {
  id             String      @id @default(uuid())
  invitationId   String      @unique
  telegramChatId String?
  emailNotify    String?
  notifyOnRsvp   Boolean     @default(true)
  notifyOnWish   Boolean     @default(false)

  invitation     Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("notification_configs")
}
